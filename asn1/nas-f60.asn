        procedureCode	NAS-ELEMENTARY-PROCEDURE.&procedureCode     ({NAS-ELEMENTARY-PROCEDURES}),
        sectyp		NAS-ELEMENTARY-PROCEDURE.&sectype ({NAS-ELEMENTARY-PROCEDURES}{@procedureCode}),
        spare		NAS-ELEMENTARY-PROCEDURE.&spare ({NAS-ELEMENTARY-PROCEDURES}{@procedureCode}),
