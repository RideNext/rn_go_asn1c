NAS-ELEMENTARY-PROCEDURES NAS-ELEMENTARY-PROCEDURE ::= {
        NAS-ELEMENTARY-PROCEDURES-CLASS-1                      |
        NAS-ELEMENTARY-PROCEDURES-CLASS-2
}

NAS-ELEMENTARY-PROCEDURES-CLASS-1 NAS-ELEMENTARY-PROCEDURE ::= {
	gMM-Mobility
}

NAS-ELEMENTARY-PROCEDURES-CLASS-2 NAS-ELEMENTARY-PROCEDURE ::= {
...
}
id-GMM-Mobility ProcedureCode ::= 7
id-Sec-Hdr-Value ProtocolIE-ID ::= 0
id-Spare-Value ProtocolIE-ID ::= 0
gMM-Mobility NAS-ELEMENTARY-PROCEDURE ::= {
        OPTION0      Registration-Request
        OPTION1      Registration-Accept
        OPTION2      Registration-Complete
        OPTION3      Registration-Reject
        OPTION4      Authentication-Request
        OPTION5      Authentication-Response
        OPTION6      Authentication-Result
        OPTION7      Authentication-Failure
        OPTION8      Authentication-Reject
        OPTION9      UL-NAS-Transport
        OPTION10     DL-NAS-Transport
        PROCEDURE CODE          id-GMM-Mobility
	SECHDRTYPE	id-Sec-Hdr-Value
	SPARE		id-Spare-Value
}

EAP-Message ::= SEQUENCE {
	msg EAP-Message-Buff
}

Auth-Param-RAND ::= SEQUENCE {
	rand Auth-Param-Rand
}

Auth-Param-AUTN ::= SEQUENCE {
	rand Auth-Param-Autn
}


Authentication-Request-Hdr ::= SEQUENCE {
	ngKSI NAS-Key-Set-ID,
	spare2 Spare-Bits4
}

Authentication-Request ::= SEQUENCE {
	protocolIEs                     ProtocolIE-Container       {{Authentication-Request-IEs}}
}

id-EAP-Message ProtocolIE-ID ::= 120
id-Auth-Req-Hdr ProtocolIE-ID ::= 86
id-Auth-Param-Rand ProtocolIE-ID ::= 33
id-Auth-Param-Autn ProtocolIE-ID ::= 32

Authentication-Request-IEs NAS-PROTOCOL-IES ::= {
	{ ID id-Auth-Req-Hdr TYPE Authentication-Request-Hdr CRITICALITY ignore PRESENCE mandatory }|
	{ ID id-Auth-Param-Rand   TYPE Auth-Param-Rand  CRITICALITY ignore PRESENCE optional} |
	{ ID id-Auth-Param-Autn   TYPE Auth-Param-Autn  CRITICALITY ignore PRESENCE optional}|
	{ ID id-EAP-Message   TYPE EAP-Message  CRITICALITY ignore PRESENCE optional}
}

Authentication-Response-Hdr ::= SEQUENCE {
	spare Spare-Null
}


Auth-Resp-Param  ::= OCTET STRING (SIZE(4..16))

Authentication-Response ::= SEQUENCE {
	protocolIEs                     ProtocolIE-Container       {{Authentication-Response-IEs}}
}
id-Auth-Res-Hdr ProtocolIE-ID ::= 87
id-Auth-Res-Param ProtocolIE-ID ::= 45
maxnoofE-RABs INTEGER ::= 256
Authentication-Response-IEs NAS-PROTOCOL-IES ::= {
	{ ID id-Auth-Res-Hdr TYPE Authentication-Response-Hdr CRITICALITY ignore PRESENCE mandatory }|
	{ ID id-Auth-Res-Param   TYPE Auth-Resp-Param  CRITICALITY ignore PRESENCE optional}|
	{ ID id-EAP-Message   TYPE EAP-Message  CRITICALITY ignore PRESENCE optional}
}

Authentication-Result-Hdr ::= SEQUENCE {
	ngKSI NAS-Key-Set-ID,
	spare2 Spare-Bits4,
        eapMsg EAP-Message
}
id-Auth-Result-Hdr ProtocolIE-ID ::= 88
Authentication-Result ::= SEQUENCE {
	protocolIEs                     ProtocolIE-Container       {{Authentication-Result-IEs}}
}

Authentication-Result-IEs NAS-PROTOCOL-IES ::= {
	{ ID id-Auth-Result-Hdr TYPE Authentication-Result-Hdr CRITICALITY ignore PRESENCE mandatory }
}

ProtocolIE-ContainerList {INTEGER : lowerBound, INTEGER : upperBound, NAS-PROTOCOL-IES : IEsSetParam} ::=
        SEQUENCE (SIZE (lowerBound..upperBound)) OF
        ProtocolIE-SingleContainer {{IEsSetParam}}

ProtocolIE-SingleContainer {NAS-PROTOCOL-IES : IEsSetParam} ::=
        ProtocolIE-Field {{IEsSetParam}}

IE-ContainerList   { NAS-PROTOCOL-IES      : IEsSetParam }        ::= ProtocolIE-ContainerList     { 1, maxnoofE-RABs,   {IEsSetParam} }

id-SNSSAI ProtocolIE-ID ::= 34

SNSSAI ::= OCTET STRING (SIZE(3..8))
RegType ::= OCTET STRING (SIZE(1))
Mob-ID ::= OCTET STRING (SIZE(2..65535))
NAS-Key-Set-ID ::= INTEGER (0..255)
GMM-Capability ::= OCTET STRING (SIZE(1..13))
UE-Sec-Capability ::= OCTET STRING (SIZE(4..6))

--NSSAI ::= IE-ContainerList  {{SNSSAI-IEs}}

NSSAI ::= SEQUENCE (SIZE(1..255)) OF  SNSSAI

--SNSSAI-IEs NAS-PROTOCOL-IES ::= {
--	{ ID id-SNSSAI TYPE SNSSAI CRITICALITY ignore PRESENCE mandatory }
--}

GS-TAI  ::= OCTET STRING (SIZE(6))
UE-NW-Capability ::= OCTET STRING (SIZE(2..13))
Uplink-Data-Status ::= OCTET STRING (SIZE(2..32))
PDU-Session-Status ::= OCTET STRING (SIZE(2..32))
PDU-Session-ID ::= OCTET STRING (SIZE(1))
MICO-Ind ::= INTEGER (0..255)
UE-Status ::= OCTET STRING (SIZE(0..1))
UE-Ussage-Setting ::= OCTET STRING (SIZE(3))
Payload-Container ::= OCTET STRING (SIZE(2..65536))
RegResults ::= OCTET STRING (SIZE(1..1))

Registration-Req-Hdr ::= SEQUENCE {
--	type Message-Type,
	regType RegType,
	ngKSI NAS-Key-Set-ID,
	spare2 Spare-Bits4,
	mobId  Mob-ID
}
Spare-Null ::= BIT STRING (SIZE(0))

Registration-Res-Hdr ::= SEQUENCE {
	regRes RegResults
}

Registration-Comp-Hdr ::= SEQUENCE {
	nullVal Spare-Null
}
Registration-Reject-Hdr ::= SEQUENCE {
	cause GMM-Cause
}

Registration-Request ::= SEQUENCE {
	protocolIEs                     ProtocolIE-Container       {{Registration-Request-IEs}}
}
Registration-Accept ::= SEQUENCE {
	protocolIEs                     ProtocolIE-Container       {{Registration-Accept-IEs}}
}
Registration-Complete ::= SEQUENCE {
	protocolIEs                     ProtocolIE-Container       {{Registration-Complete-IEs}}
}
Registration-Reject ::= SEQUENCE {
	protocolIEs                     ProtocolIE-Container       {{Registration-Reject-IEs}}
}

id-Reg-Req-Hdr ProtocolIE-ID ::= 65
id-Reg-Res-Hdr ProtocolIE-ID ::= 66
id-Reg-Comp-Hdr ProtocolIE-ID ::= 67
id-Reg-Reject-Hdr ProtocolIE-ID ::= 68
id-NAS-KS-ID ProtocolIE-ID ::= 12
id-GMM-Cap-ID ProtocolIE-ID ::= 16
id-UE-Sec-Capability ProtocolIE-ID ::= 46
id-NSSAI ProtocolIE-ID ::= 47
id-GS-TAI ProtocolIE-ID ::= 82
id-UE-NW-Capability ProtocolIE-ID ::= 101
id-Uplink-Data-Status ProtocolIE-ID ::= 64
id-PDU-Session-Status ProtocolIE-ID ::= 80
id-MICO-Ind ProtocolIE-ID ::= 11
id-UE-Status ProtocolIE-ID ::= 43

Registration-Request-IEs NAS-PROTOCOL-IES ::= {
	{ ID id-Reg-Req-Hdr TYPE Registration-Req-Hdr CRITICALITY ignore PRESENCE mandatory }|
--	{ ID id-NAS-KS-ID   TYPE NAS-Key-Set-ID  CRITICALITY ignore PRESENCE optional}|
	{ ID id-GMM-Cap-ID   TYPE GMM-Capability  CRITICALITY ignore PRESENCE optional}|
	{ ID id-UE-Sec-Capability   TYPE UE-Sec-Capability  CRITICALITY ignore PRESENCE optional}|
--	{ ID id-NSSAI   TYPE NSSAI  CRITICALITY ignore PRESENCE optional}|
	{ ID id-GS-TAI   TYPE GS-TAI  CRITICALITY ignore PRESENCE optional}|
	{ ID id-UE-NW-Capability   TYPE UE-NW-Capability  CRITICALITY ignore PRESENCE optional}|
	{ ID id-Uplink-Data-Status   TYPE Uplink-Data-Status  CRITICALITY ignore PRESENCE optional}|
	{ ID id-PDU-Session-Status   TYPE PDU-Session-Status  CRITICALITY ignore PRESENCE optional}|
--	{ ID id-MICO-Ind   TYPE MICO-Ind  CRITICALITY ignore PRESENCE optional}|
	{ ID id-UE-Status   TYPE UE-Status  CRITICALITY ignore PRESENCE optional}
}
TBCD-STRING ::= OCTET STRING (SIZE (3))
PLMNidentity   ::= TBCD-STRING
TAC ::= OCTET STRING (SIZE (2))
TAI ::= SEQUENCE {
        pLMNidentity   PLMNidentity,
        tAC            TAC
}

maxPLMNs INTEGER ::= 255
maxTAIs INTEGER ::= 255

id-NG-GUTI ProtocolIE-ID ::= 44
id-PLMN-List ProtocolIE-ID ::= 74
id-TAI-List ProtocolIE-ID ::= 84
id-Allowed-NSSAI ProtocolIE-ID ::= 112
id-Reject-NSSAI ProtocolIE-ID ::= 17
id-Config-NSSAI ProtocolIE-ID ::= 49
NG-GUTI ::= OCTET STRING (SIZE(0..13))
--PLMN ::= OCTET STRING (SIZE(3))
PLMN-List ::= SEQUENCE (SIZE(1..maxPLMNs)) OF PLMNidentity
TAI-List ::= SEQUENCE (SIZE(1..maxTAIs)) OF TAI
GPRS-Timer ::= OCTET STRING (SIZE(1..1))
id-T3512-Timer ProtocolIE-ID ::= 94
id-T3346-Timer ProtocolIE-ID ::= 95
id-T3502-Timer ProtocolIE-ID ::= 22
T3512-Timer ::= GPRS-Timer
T3346-Timer ::= GPRS-Timer
T3502-Timer ::= GPRS-Timer

Registration-Accept-IEs NAS-PROTOCOL-IES ::= {
	{ ID id-Reg-Res-Hdr TYPE Registration-Res-Hdr CRITICALITY ignore PRESENCE mandatory }|
	{ ID id-NG-GUTI TYPE NG-GUTI CRITICALITY ignore PRESENCE optional }|
	{ ID id-PLMN-List TYPE PLMN-List CRITICALITY ignore PRESENCE optional }|
	{ ID id-TAI-List TYPE TAI-List CRITICALITY ignore PRESENCE optional }|
	{ ID id-Allowed-NSSAI TYPE NSSAI CRITICALITY ignore PRESENCE optional }|
	{ ID id-Reject-NSSAI TYPE NSSAI CRITICALITY ignore PRESENCE optional }|
	{ ID id-Config-NSSAI TYPE NSSAI CRITICALITY ignore PRESENCE optional }|
	{ ID id-PDU-Session-Status   TYPE PDU-Session-Status  CRITICALITY ignore PRESENCE optional}|
	{ ID id-T3512-Timer   TYPE T3512-Timer  CRITICALITY ignore PRESENCE optional}|
	{ ID id-EAP-Message   TYPE EAP-Message  CRITICALITY ignore PRESENCE optional}
}
Registration-Complete-IEs NAS-PROTOCOL-IES ::= {
	{ ID id-Reg-Comp-Hdr TYPE Registration-Comp-Hdr CRITICALITY ignore PRESENCE mandatory }
}
Registration-Reject-IEs NAS-PROTOCOL-IES ::= {
	{ ID id-Reg-Reject-Hdr TYPE Registration-Reject-Hdr CRITICALITY ignore PRESENCE mandatory }|
	{ ID id-T3346-Timer TYPE T3346-Timer CRITICALITY ignore PRESENCE mandatory }|
	{ ID id-T3502-Timer TYPE T3502-Timer CRITICALITY ignore PRESENCE mandatory }|
	{ ID id-EAP-Message   TYPE EAP-Message  CRITICALITY ignore PRESENCE optional}
}

GMM-Cause ::= INTEGER  (0..255)

Atut-Failure-Param ::= OCTET STRING (SIZE(1..14))

id-Auth-Fail-Hdr ProtocolIE-ID ::= 89
id-GMM-Cause ProtocolIE-ID ::= 48

Authentication-Failure-Hdr ::= SEQUENCE {
	gmmCause GMM-Cause
}

Authentication-Failure ::= SEQUENCE {
	protocolIEs                     ProtocolIE-Container       {{Authentication-Failure-IEs}}
}

Authentication-Failure-IEs NAS-PROTOCOL-IES ::= {
	{ ID id-Auth-Fail-Hdr TYPE Authentication-Failure-Hdr CRITICALITY ignore PRESENCE mandatory }|
	{ ID id-GMM-Cause TYPE GMM-Cause CRITICALITY ignore PRESENCE optional }
}

id-Auth-Rej-Hdr ProtocolIE-ID ::= 90
Authentication-Reject-Hdr ::= SEQUENCE {
	spare Spare-Null
}

Authentication-Reject ::= SEQUENCE {
	protocolIEs                     ProtocolIE-Container       {{Authentication-Reject-IEs}}
}
Authentication-Reject-IEs NAS-PROTOCOL-IES ::= {
	{ ID id-Auth-Rej-Hdr TYPE Authentication-Reject-Hdr CRITICALITY ignore PRESENCE mandatory }
}

id-UL-NAS-Transport-Hdr ProtocolIE-ID ::= 103
id-PDU-Session-ID ProtocolIE-ID ::= 112
id-oldPDU-Session-ID ProtocolIE-ID ::= 97

UL-NAS-Transport-Hdr ::= SEQUENCE {
	pcType Spare-Bits4,
	spare Spare-Bits4,
        payloadContainer  OCTET STRING (SIZE(0..65535))
}
UL-NAS-Transport ::= SEQUENCE {
	protocolIEs                     ProtocolIE-Container       {{UL-NAS-Transport-IEs}}
}
UL-NAS-Transport-IEs NAS-PROTOCOL-IES ::= {
	{ ID id-UL-NAS-Transport-Hdr TYPE UL-NAS-Transport-Hdr CRITICALITY ignore PRESENCE mandatory }|
	{ ID id-PDU-Session-ID TYPE PDU-Session-ID CRITICALITY ignore PRESENCE optional }|
	{ ID id-oldPDU-Session-ID TYPE PDU-Session-ID CRITICALITY ignore PRESENCE optional }|
	{ ID id-SNSSAI TYPE SNSSAI CRITICALITY ignore PRESENCE optional }
}

id-DL-NAS-Transport-Hdr ProtocolIE-ID ::= 104
id-DL-NAS-Addl-Info ProtocolIE-ID ::= 36
DL-NAS-Addl-Info ::= OCTET STRING (SIZE(1..65535))

DL-NAS-Transport-Hdr ::= SEQUENCE {
	pcType Spare-Bits4,
	spare Spare-Bits4,
        payloadContainer  OCTET STRING (SIZE(0..65535))
}
DL-NAS-Transport ::= SEQUENCE {
	protocolIEs                     ProtocolIE-Container       {{DL-NAS-Transport-IEs}}
}
DL-NAS-Transport-IEs NAS-PROTOCOL-IES ::= {
	{ ID id-DL-NAS-Transport-Hdr TYPE DL-NAS-Transport-Hdr CRITICALITY ignore PRESENCE mandatory }|
	{ ID id-PDU-Session-ID TYPE PDU-Session-ID CRITICALITY ignore PRESENCE optional }|
	{ ID id-DL-NAS-Addl-Info TYPE DL-NAS-Addl-Info CRITICALITY ignore PRESENCE optional }|
	{ ID id-GMM-Cause TYPE GMM-Cause CRITICALITY ignore PRESENCE optional }
}


