
NAS-PDU-Descriptions  {
itu-t (0) identified-organization (4) etsi (0) mobileDomain (0)
eps-Access (21) modules (3) s1ap (1) version1 (1) s1ap-PDU-Descriptions (0)}

DEFINITIONS AUTOMATIC TAGS ::=

BEGIN

maxProtocolIEs INTEGER ::= 256

ProcedureCode ::= INTEGER (0..255)
ProtocolIE-ID ::= INTEGER (0..255)

Presance ::= ENUMERATED {
	mandatory,
	optional,
	conditional
}
Criticality ::= ENUMERATED {
   ignore
}

Ext-Prot-Disc ::= OCTET STRING (SIZE(1))
Sec-Header-Type ::= BIT STRING (SIZE(4))
Spare-Bits4 ::= BIT STRING (SIZE(4))
Message-Type ::= INTEGER (0..255)
NAS-Key-Set-ID ::= BIT STRING (SIZE(4))
Auth-Param-Rand ::= OCTET STRING (SIZE(16))
Auth-Param-Autn ::= OCTET STRING (SIZE(0..16))

EAP-Message-Buff ::= OCTET STRING (SIZE(4..1500))

NAS-PROTOCOL-IES ::= CLASS {
	&id	  ProtocolIE-ID UNIQUE,
	&criticality    Criticality,
	&Value,
	&presance Presance
}
WITH SYNTAX {
	ID		&id,
        CRITICALITY	&criticality
	TYPE		&Value,
	PRESENCE	&presance
}

NAS-ELEMENTARY-PROCEDURE ::= CLASS {
        &Option0,
        &Option1	OPTIONAL,
        &Option2	OPTIONAL,
        &Option3	OPTIONAL,
        &Option4	OPTIONAL,
        &Option5	OPTIONAL,
        &Option6	OPTIONAL,
        &Option7	OPTIONAL,
        &Option8	OPTIONAL,
        &Option9	OPTIONAL,
        &Option10	OPTIONAL,
        &Option11	OPTIONAL,
        &Option12	OPTIONAL,
        &Option13	OPTIONAL,
        &Option14	OPTIONAL,
        &Option15	OPTIONAL,
        &Option16	OPTIONAL,
        &Option17	OPTIONAL,
        &Option18	OPTIONAL,
        &Option19	OPTIONAL,
        &Option20	OPTIONAL,
        &Option21	OPTIONAL,
        &Option22	OPTIONAL,
        &Option23	OPTIONAL,
        &Option24	OPTIONAL,
        &Option25	OPTIONAL,
        &Option26	OPTIONAL,
        &Option27	OPTIONAL,
        &Option28	OPTIONAL,
        &Option29	OPTIONAL,
        &Option30	OPTIONAL,
        &Option31	OPTIONAL,
        &procedureCode		ProcedureCode   UNIQUE,
	&sectype Sec-Header-Type,
	&spare 	Spare-Bits4
}
WITH SYNTAX {
        OPTION0		&Option0
        [OPTION1	&Option1]
        [OPTION2	&Option2]
        [OPTION3	&Option3]
        [OPTION4	&Option4]
        [OPTION5	&Option5]
        [OPTION6	&Option6]
        [OPTION7	&Option7]
        [OPTION8	&Option8]
        [OPTION9	&Option9]
        [OPTION10	&Option10]
        [OPTION11	&Option11]
        [OPTION12	&Option12]
        [OPTION13	&Option13]
        [OPTION14	&Option14]
        [OPTION15	&Option15]
        [OPTION16	&Option16]
        [OPTION17	&Option17]
        [OPTION18	&Option18]
        [OPTION19	&Option19]
        [OPTION20	&Option20]
        [OPTION21	&Option21]
        [OPTION22	&Option22]
        [OPTION23	&Option23]
        [OPTION24	&Option24]
        [OPTION25	&Option25]
        [OPTION26	&Option26]
        [OPTION27	&Option27]
        [OPTION28	&Option28]
        [OPTION29	&Option29]
        [OPTION30	&Option30]
        [OPTION31	&Option31]
        PROCEDURE CODE		&procedureCode,
	SECHDRTYPE	&sectype,
	SPARE		&spare
}

NAS-PDU ::= CHOICE {
        registration-Request       Option0,
        registration-Accept       Option1,
        registration-Complete       Option2,
        registration-reject       Option3,
        auth-Reqequest       Option4,
        auth-Response       Option5,
        auth-Results       Option6,
        auth-Failure       Option7,
        auth-Reject       Option8,
        ul-Nas-Transport       Option9,
        dl-Nas-Transport       Option10,
        option11       Option11,
        option12       Option12,
        option13       Option13,
        option14       Option14,
        option15       Option15,
        option16       Option16,
        option17       Option17,
        option18       Option18,
        option19       Option19,
        option20       Option20,
        option21       Option21,
        option22       Option22,
        option23       Option23,
        option24       Option24,
        option25       Option25,
        option26       Option26,
        option27       Option27,
        option28       Option28,
        option29       Option29,
        option30       Option30,
        option31       Option31
}
ProtocolIE-Container {NAS-PROTOCOL-IES : IEsSetParam} ::=
        SEQUENCE (SIZE (0..maxProtocolIEs)) OF
        ProtocolIE-Field {{IEsSetParam}}

ProtocolIE-Field {S1AP-PROTOCOL-IES : IEsSetParam} ::= SEQUENCE {
        id                      NAS-PROTOCOL-IES.&id     ({IEsSetParam}),
        value                   NAS-PROTOCOL-IES.&Value  ({IEsSetParam}{@id})
}


